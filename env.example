# 🎬 AI 단편영화 생성기 환경변수 설정
# 이 파일을 복사하여 .env 파일을 만들고 실제 API 키를 입력하세요

# OpenAI API 키 (필수)
# https://platform.openai.com/api-keys 에서 발급받으세요
OPENAI_API_KEY=your_openai_api_key_here

# Runway ML API 키 (선택사항)
# https://runwayml.com/ 에서 발급받으세요
# 없으면 Mock 모드로 실행됩니다
RUNWAY_API_KEY=your_runway_api_key_here

# 서버 포트 (Render에서 자동 설정)
# PORT=8000

# Python 버전 (Render 배포용)
# PYTHON_VERSION=3.11.0 